# Postgres (Vercel Postgres / Neon). Se completa solo al crear la base desde el dashboard de Vercel.
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Service Account de Google Cloud con acceso de Editor a la planilla de respaldo.
GOOGLE_SERVICE_ACCOUNT_EMAIL="gordos-sheets@tu-proyecto.iam.gserviceaccount.com"
# Pegar la clave privada completa (incluye BEGIN/END). Si la pegás en una sola línea, los saltos de línea deben ir como \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID de la planilla (la parte de la URL entre /d/ y /edit): https://docs.google.com/spreadsheets/d/ESTE_ID/edit
GOOGLE_SHEET_ID=""

# Opcional: link directo a la planilla, para mostrar el botón "Abrir planilla" en Configuración.
# Debe empezar con NEXT_PUBLIC_ porque se usa en el navegador.
NEXT_PUBLIC_GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/ESTE_ID/edit"

# URL pública del sitio ya desplegado (sin barra final). La usa el bot de WhatsApp para armar el link a /pedir.
NEXT_PUBLIC_SITE_URL="https://gordos-burger.vercel.app"

# --- Bot de WhatsApp (Meta Cloud API) — opcional, el sistema funciona igual sin esto ---
# Token secreto que vos mismo inventás (cualquier string) y pegás también al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN="elegí-un-secreto-cualquiera"
# Access token del WhatsApp Business App (Meta for Developers > tu app > WhatsApp > API Setup).
WHATSAPP_ACCESS_TOKEN=""
# Phone Number ID (mismo lugar que el access token).
WHATSAPP_PHONE_NUMBER_ID=""

# --- IA del bot (OpenAI) — opcional, sin esto el bot solo manda el link de pedidos ---
# Se crea en https://platform.openai.com/api-keys
OPENAI_API_KEY=""
